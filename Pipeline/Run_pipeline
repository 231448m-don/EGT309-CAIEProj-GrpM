# pipeline/run_pipeline.py
import subprocess

def run(cmd: str):
    print(f"\n=== Running: {cmd} ===")
    subprocess.run(cmd, shell=True, check=True)

def main():
    # 1. Logistic Regression
    run("python src/logistic_regression.py")

    # 2. Random Forest
    run("python src/random_forest.py")

    # 3. XGBoost
    run("python src/xgb_model.py")   # use your actual file name here

if __name__ == "__main__":
    main()

